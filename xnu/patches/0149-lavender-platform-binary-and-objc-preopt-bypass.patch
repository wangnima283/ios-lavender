+#if defined(ARM64_BOARD_CONFIG_SANTONI) || defined(ARM64_BOARD_CONFIG_LAVENDER)
+	/* On Lavender/Santoni, never kill processes or panic due to code signature failure */
+	if (error != 0) {
+		error = 0;
