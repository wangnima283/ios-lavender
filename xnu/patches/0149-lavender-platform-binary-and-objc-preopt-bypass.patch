diff --git a/bsd/kern/kern_cs.c b/bsd/kern/kern_cs.c
index 52fdc5d..e248e43 100644
--- a/bsd/kern/kern_cs.c
+++ b/bsd/kern/kern_cs.c
@@ -248,6 +248,12 @@
 int
 cs_invalid_page(addr64_t vaddr, boolean_t *cs_killed)
 {
+#if defined(ARM64_BOARD_CONFIG_SANTONI) || defined(ARM64_BOARD_CONFIG_LAVENDER)
+	if (cs_killed) {
+		*cs_killed = FALSE;
+	}
+	return 0;
+#endif
 	struct proc     *p;
 	int             send_kill = 0, retval = 0, verbose = cs_debug;
 	uint64_t flags;
@@ -863,6 +869,9 @@ csvnode_get_teamid(struct vnode *vp, off_t offset)
 int
 csproc_get_platform_binary(struct proc *p)
 {
+#if defined(ARM64_BOARD_CONFIG_SANTONI) || defined(ARM64_BOARD_CONFIG_LAVENDER)
+	return 1;
+#else
 	struct cs_blob *csblob;
 
 	csblob = csproc_get_blob(p);
@@ -870,6 +879,7 @@ csproc_get_platform_binary(struct proc *p)
 	/* If there is no csblob this returns 0 because
 	 *  it is true that it is not a platform binary */
 	return (csblob == NULL) ? 0 : csblob->csb_platform_binary;
+#endif
 }
 
