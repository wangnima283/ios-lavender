+/*
+ * Boot-arg sweetouchtest=N: every N seconds send one synthetic swipe up from
+ * the bottom edge, the gesture that unlocks the lock screen. It proves the
+ * digitizer path (SweetHIDTouch -> backboardd -> SpringBoard) with no touch
+ * hardware at all: whyred has no I2C/GPIO driver yet, so without this the
+ * digitizer never reports a finger and the lock screen cannot be moved.
+ */
+void
+SweetHIDTouch::swipeFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	SweetHIDTouch *self = (SweetHIDTouch *)owner;
+	const int steps = 12;
+	int step = self->fSwipeStep;
+
+	if (step < 0) {
+		self->fSwipeStep = step = 0;
+		IOLog("SWEET HID: synthetic swipe %u (no touch hardware)\n", self->fSwipeCount + 1);
+	}
+	/*
+	 * A home-gesture touch must begin inside the bottom edge band: touch()
+	 * marks only y > 2399-48 as kIOHIDDigitizerEventFromEdgeTip, and UIKit
+	 * derives UITouch's edge type from that bit. Start at 2390, lift at
+	 * 800 (well past the unlock threshold) after twelve 25 ms steps.
+	 */
+	if (step == 0) {
+		self->touch(0, true, 540, 2390);
+	} else if (step <= steps) {
+		int y = 2390 - (step * (2390 - 800)) / steps;
+		self->touch(0, true, 540, y);
+	} else {
+		self->touch(0, false, 540, 800);
+		self->fSwipeStep = -1;
+		if (++self->fSwipeCount < 30) {
+			IOLog("SWEET HID: synthetic swipe %u sent, next in %u s\n",
+			    self->fSwipeCount, self->fSwipeSecs);
+			sender->setTimeoutMS(self->fSwipeSecs * 1000);
+		}
+		return;
+	}
+	self->fSwipeStep++;
+	sender->setTimeoutMS(25);
+}
+
