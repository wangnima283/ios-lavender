+			    !PE_parse_boot_argn("enable_all_daemons", NULL, 0)) {
+				printf("lavender: %s spawn bypassed (suspended) to prevent crash loop\n", p->p_name);
+				task_suspend_internal(proc_task(p));
+				error = 0;
+				goto done;
+			}
+#endif
 #else
 			printf("Allowing spawn of iOS binary %s since it has "
