+#if defined(ARM64_BOARD_CONFIG_SANTONI) || defined(SANTONI) || defined(ARM64_BOARD_CONFIG_LAVENDER) || defined(LAVENDER)
+extern void sweet_early_putc(char c);
+
+static void
+santoni_early_serial_init(void)
+{
+	extern bool disable_serial_output;
+	disable_serial_output = false;
+}
+
+static unsigned int
+santoni_early_serial_tx_ready(void)
+{
+	return 1;
+}
+
+static void
+santoni_early_serial_tx_data(uint8_t c)
+{
+	extern bool disable_kprintf_output;
+	if (!disable_kprintf_output) {
+		sweet_early_putc((char)c);
+	}
+}
+
+static unsigned int
+santoni_early_serial_rx_ready(void)
+{
+	return 0;
+}
+
+static uint8_t
+santoni_early_serial_rx_data(void)
+{
+	return 0;
+}
+
+SECURITY_READ_ONLY_LATE(static struct pe_serial_functions) santoni_early_serial_functions =
+{
+	.init = santoni_early_serial_init,
+	.transmit_ready = santoni_early_serial_tx_ready,
+	.transmit_data = santoni_early_serial_tx_data,
+	.receive_ready = santoni_early_serial_rx_ready,
+	.receive_data = santoni_early_serial_rx_data,
+	.device = SERIAL_SWEET_FBCON
+};
+#endif
+
 static void
 fbcon_probe(void)
 {
+#if defined(ARM64_BOARD_CONFIG_SANTONI) || defined(SANTONI) || defined(ARM64_BOARD_CONFIG_LAVENDER) || defined(LAVENDER)
